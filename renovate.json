{
  "extends": ["github>dev-hato/renovate-config"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "ignoreDeps": [
    "go",
    "node-fetch",
    "eslint",
    "textlint",
    "zricethezav/gitleaks",
    "gitleaks/gitleaks"
  ],
  "packageRules": [
    {
      "description": "Node.js versions follow the frontend Docker image via update-package",
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "Updated together with Super-Linter by update-package",
      "matchFileNames": ["package.json"],
      "matchPackageNames": [
        "textlint-rule-*",
        "textlint-filter-rule-*",
        "@*/textlint-rule-*",
        "@*/textlint-filter-rule-*"
      ],
      "enabled": false
    },
    {
      "description": "Updated together with Super-Linter by update-package",
      "matchFileNames": ["test/e2e/package.json"],
      "matchPackageNames": ["eslint-plugin*"],
      "enabled": false
    },
    {
      "description": "The elm package marks every compiler release as a prerelease, such as 0.19.2-0",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["elm"],
      "ignoreUnstable": false
    },
    {
      "groupName": "artifact",
      "matchPackageNames": [
        "actions/download-artifact",
        "actions/upload-artifact"
      ]
    }
  ]
}
